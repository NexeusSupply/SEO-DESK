# Copy to .env and fill in what you have. Anything left blank simply disables that module.

PORT=3040
DB_PATH=./data/seo-desk.sqlite

# DataForSEO (rank tracking, keyword volume, backlinks, competitor keywords)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Default market for SERP/keyword lookups
DFS_LOCATION_CODE=2554          # New Zealand
DFS_LANGUAGE_CODE=en

# Google Search Console — path to a service-account JSON key.
# Add the service account's email as a user on each property in Search Console.
GSC_SERVICE_ACCOUNT_JSON=./data/gsc-service-account.json
# ...or, on a host where you'd rather not upload a file (Railway), paste the whole JSON into this instead:
GSC_SERVICE_ACCOUNT_JSON_CONTENT=

# Google Business Profile — OAuth client (Desktop app type) from the same Cloud project, with the
# Business Profile APIs enabled and access approved. Run `npm run gbp:auth` once to get the refresh token.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# Cloudflare Access. Set both and the app refuses any request that didn't come through Access.
# Team domain looks like: comhla.cloudflareaccess.com   AUD is on the Access application's Overview tab.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Until Access is set up: a password for the whole site (any username). Ignored once the two values above are set.
PREVIEW_PASSWORD=

# Hard cap on DataForSEO spend per calendar month (USD). Rank and local checks stop posting new tasks past this.
DFS_MONTHLY_CAP_USD=10

# Crawler
CRAWL_MAX_PAGES=500
CRAWL_CONCURRENCY=4
CRAWL_USER_AGENT=SEODeskBot/0.1 (+internal)

# Weekly digest email (SMTP). Leave SMTP_HOST blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=seo-desk@example.com
DIGEST_TO=

# Schedules (cron, server local time). The Docker image sets TZ=Pacific/Auckland; set TZ yourself elsewhere.
CRON_AUDIT=0 2 * * 1        # Mondays 02:00
CRON_RANKS=0 6 * * *        # daily 06:00
CRON_GSC=30 6 * * *         # daily 06:30
CRON_COMPETITORS=0 3 1 * *  # monthly
CRON_DIGEST=0 8 * * 1       # Mondays 08:00
CRON_GBP=15 7 * * *         # daily 07:15 — Business Profile listings, reviews, performance
CRON_LOCAL=0 5 * * 1        # Mondays — post the week's map-pack checks to DataForSEO's standard queue + NAP check
CRON_LOCAL_COLLECT=0 */2 * * *  # every 2h — collect finished map-pack results
