# Copy to .env and fill in what you have. Anything left blank simply disables that module.

PORT=3040
DB_PATH=./data/seo-desk.sqlite

# DataForSEO (rank tracking, keyword volume, backlinks, competitor keywords)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Default market for SERP/keyword lookups
DFS_LOCATION_CODE=2554          # New Zealand
DFS_LANGUAGE_CODE=en

# Google Search Console — path to a service-account JSON key.
# Add the service account's email as a user on each property in Search Console.
GSC_SERVICE_ACCOUNT_JSON=./data/gsc-service-account.json

# Google Business Profile — OAuth client (Desktop app type) from the same Cloud project, with the
# Business Profile APIs enabled and access approved. Run `npm run gbp:auth` once to get the refresh token.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# Crawler
CRAWL_MAX_PAGES=500
CRAWL_CONCURRENCY=4
CRAWL_USER_AGENT=SEODeskBot/0.1 (+internal)

# Weekly digest email (SMTP). Leave SMTP_HOST blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=seo-desk@example.com
DIGEST_TO=

# Schedules (cron, server local time)
CRON_AUDIT=0 2 * * 1        # Mondays 02:00
CRON_RANKS=0 6 * * *        # daily 06:00
CRON_GSC=30 6 * * *         # daily 06:30
CRON_COMPETITORS=0 3 1 * *  # monthly
CRON_DIGEST=0 8 * * 1       # Mondays 08:00
CRON_GBP=15 7 * * *         # daily 07:15 — Business Profile listings, reviews, performance
CRON_LOCAL=0 5 * * 1,4      # Mon/Thu — local map-pack rank checks + NAP consistency
