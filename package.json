{
  "name": "seo-desk",
  "version": "0.1.0",
  "description": "Self-hosted SEO dashboard: site audits, Search Console, rank tracking and competitor research across a portfolio of brands.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "audit": "node src/cli.js audit",
    "ranks": "node src/cli.js ranks",
    "gsc": "node src/cli.js gsc",
    "competitors": "node src/cli.js competitors",
    "digest": "node src/cli.js digest",
    "gbp": "node src/cli.js gbp",
    "local": "node src/cli.js local",
    "meta": "node src/cli.js meta",
    "ads": "node src/cli.js ads",
    "gbp:auth": "node src/data/gbp-auth.js"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "robots-parser": "^3.0.1"
  }
}
